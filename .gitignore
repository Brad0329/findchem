# 개인 설정·비밀정보 (커밋 금지)
.claude/settings.local.json
.env

# 릴리스 서명 키 (비밀번호·keystore — 저장소에 절대 넣지 않는다).
# key.properties는 flutter create가 만든 android/.gitignore에도 있다 — 비밀정보라 여기에도 적어 둔다
# (그 파일은 재생성될 수 있다).
/android/key.properties
*.jks
*.keystore

# AI 커밋 메시지 파일 (고정 경로 — 노하우_승인_대기_최소화.md 참조)
.commit_msg.txt

# Office가 파일을 열어 둔 동안 만드는 잠금 파일
~$*

# 동봉 파이썬 도구(측정기·훅)의 부산물
__pycache__/
.pytest_cache/

# Flutter/Dart 재생성 가능물 (flutter create 3.35.6 기본 .gitignore에서 이 스택 해당분만)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release

# IDE (flutter create가 만드는 IntelliJ 파일)
*.iml
*.ipr
*.iws
.idea/
